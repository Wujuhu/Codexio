      "css": ".ds-example{display:inline-block;background:#101012;color:#F0F0F3;padding:16px;border-radius:14px;font-family:'Microsoft YaHei UI','Segoe UI',sans-serif;font-size:13px;}.ds-input{font-family:'Microsoft YaHei UI','Segoe UI',sans-serif;font-size:13px;background:#1B1B1F;color:#F0F0F3;border:1px solid #44444D;border-radius:7px;padding:7px 10px;min-height:18px;width:280px}.ds-input::placeholder{color:#AFB0BA}.ds-input:focus-visible{outline:none;border-color:#DDDDE5}.ds-input:disabled{color:#AFB0BA}"
    },
    {
      "name": "Persistent navigation",
      "kind": "nav",
      "refersTo": "navigation-selected",
      "description": "Full-width native list rows start in Overview, Logs, Trends, Subscription, Pricing, Settings order. Overview stays first; subsequent native drag, context-menu and Alt-arrow ordering persists.",
      "html": "<nav class=\"ds-nav\" aria-label=\"主导航\"><strong class=\"ds-brand\">Codexio</strong><button class=\"ds-nav-item\" aria-current=\"page\">概览</button><button class=\"ds-nav-item\">日志</button><button class=\"ds-nav-item\">用量</button><button class=\"ds-nav-item\">订阅</button><button class=\"ds-nav-item\">定价</button><button class=\"ds-nav-item\">设置</button></nav>",
      "css": ".ds-nav{width:156px;padding:20px 12px;background:#202022;color:#F0F0F3;font-family:'Microsoft YaHei UI','Segoe UI',sans-serif;font-size:13px;}.ds-brand{display:block;font-size:18px;font-weight:600;padding:0 8px 18px}.ds-nav-item{display:block;width:100%;min-height:39px;margin:4px 0;border:none;border-radius:8px;background:transparent;color:#AFB0BA;text-align:left;padding:7px 10px;font-family:'Microsoft YaHei UI','Segoe UI',sans-serif;font-size:13px;}.ds-nav-item[aria-current]{background:#303035;color:#F0F0F3}.ds-nav-item:hover{background:#292930}.ds-nav-item:focus-visible{outline:none;background:#303035;color:#F0F0F3}"
    },
    {
