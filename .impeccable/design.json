      "css": ".ds-example{display:inline-block;background:#101012;color:#F0F0F3;padding:16px;border-radius:14px;font-family:'Microsoft YaHei UI','Segoe UI',sans-serif;font-size:13px;}.ds-segments{display:inline-flex;gap:2px;padding:3px;background:#1B1B1F;border-radius:8px}.ds-segment{font-family:'Microsoft YaHei UI','Segoe UI',sans-serif;font-size:13px;font-size:12px;border:none;border-radius:8px;background:transparent;color:#AFB0BA;padding:5px 10px}.ds-segment[aria-pressed=true]{background:#303035;color:#F0F0F3}.ds-segment:hover{background:#303035}.ds-segment:focus-visible{outline:none;border:2px solid #DDDDE5}"
    },
    {
      "name": "Summary card",
