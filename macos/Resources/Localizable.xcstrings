    "只编辑 Standard 基础价；Fast 与长上下文单价由 Codex 规则生成": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Edit Standard base prices. Codex rules determine Fast and long-context prices."
